        {
          "type": "pickup",
          "actor": "mary",
          "object": "apple"
        },
        {
          "type": "pickup",
          "actor": "john",
          "object": "orange"
        },
        {
          "type": "move",
          "actor": "mary",
          "location": "hallway"
        },
        {
          "type": "release",
          "actor": "john",
          "object": "orange"
        },
        {
          "type": "move",
          "actor": "mary",
          "location": "garden"
        }
